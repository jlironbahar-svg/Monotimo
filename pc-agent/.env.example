# ---------------------------------------------------------------------------
# Desktop Friend — PC agent configuration
#
# Copy this file to `.env` (same folder) and fill in your keys:
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows)
#
# `.env` is git-ignored. Never commit real API keys: this repository is public,
# and Groq automatically revokes keys that show up on GitHub.
#
# You can also leave the keys empty here and set them from the phone app
# (Settings -> AI keys). The phone sends them to this PC, which saves them
# into this .env file. Keys never leave your PC except to call Groq/ElevenLabs.
# ---------------------------------------------------------------------------

# --- AI keys --------------------------------------------------------------
# https://console.groq.com/keys  (starts with gsk_)
GROQ_API_KEY=
# https://elevenlabs.io/app/settings/api-keys  (usually starts with sk_)
ELEVENLABS_API_KEY=

# --- Voice (ElevenLabs) ---------------------------------------------------
# Default "Jessica": young, playful, warm. Any voice ID from your ElevenLabs voice library works.
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Models (Groq) --------------------------------------------------------
# "auto" = pick a working model automatically. If a configured model is retired by Groq, the agent
# switches to a working one by itself and saves it here. `python -m desktop_friend --check` shows the result.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=auto
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_SEARCH_MODEL=groq/compound-mini

# --- Server ---------------------------------------------------------------
DF_HOST=0.0.0.0
DF_PORT=8765
# Name shown on the phone (defaults to this computer's hostname)
DF_PC_NAME=

# --- Behaviour ------------------------------------------------------------
# Colour of the AI's own cursor overlay
DF_CURSOR_COLOR=#2F7BFF
# Show the blue cursor overlay on start
DF_CURSOR_VISIBLE=true
# Little chimes on the PC when the friend points / clicks
DF_PC_SOUNDS=true
# Allow real mouse clicks, scrolling and typing (pointing always works)
DF_ALLOW_AUTOMATION=true
# Put your real mouse back where it was after the AI clicks something
DF_RESTORE_MOUSE=true
# Second "zoomed-in" vision pass for more accurate pointing (slower, more accurate)
DF_VISION_REFINE=true
# Search engine opened in your browser; {query} is replaced
DF_SEARCH_URL=https://www.google.com/search?q={query}
